# ============================================================
#  .env.example —— 环境变量模板（会进 git，所以只有名字、没有值）
#
#  用法（Windows 首次配置）：
#     Copy-Item .env.example .env
#     然后编辑 .env 把空值填上
#
#  用法（云服务器）：
#     内容写到 /etc/music/env，并 chmod 600，由 systemd 的 EnvironmentFile 加载
# ============================================================

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://localhost:3306/music_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- 邮件（QQ 邮箱 SMTP，用于注册验证码 / 找回密码）----------
# 授权码获取：QQ 邮箱 → 设置 → 账户 → 开启 POP3/SMTP → 生成授权码
MAIL_HOST=smtp.qq.com
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 文件存储 ----------
# 手动传相对路径 ./uploads 时以启动工作目录为基准；
# 服务器上建议用绝对路径，例如 /opt/music/uploads
UPLOAD_DIR=./uploads

# ---------- JWT 签名密钥（必填）----------
# 生成方式（三选一）：
#   PowerShell: $b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 48
#   在线生成器一律不要用
# 注意：换这个值会让所有已登录用户掉线，属于预期行为
JWT_SECRET=

# ---------- 可选：对象存储（默认不启用）----------
# 留空 = 所有上传都存本地磁盘（推荐，当前方案）
# 五項都填上才会启用混合存储，音频/封面/歌词会自动路由到 S3
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=
# S3_URL_PREFIX=
